<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.lostandfound.controller.StudentDashboardController"
            stylesheets="@../css/style.css" styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 15 25;">
            <Label text="🎒 Campus Lost &amp; Found" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #145DA0;"/>
            <VBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Welcome, Student" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 6;"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="8" style="-fx-background-color: #145DA0; -fx-padding: 20 10;" prefWidth="200">
            <Button text="📢 Report Item" onAction="#handleReportItem" maxWidth="Infinity" styleClass="sidebar-button"/>
            <Button text="📋 My Reports" onAction="#handleMyReports" maxWidth="Infinity" styleClass="sidebar-button"/>
            <Button text="🔍 Browse Items" onAction="#handleBrowseItems" maxWidth="Infinity" styleClass="sidebar-button"/>
            <Button text="✅ My Claims" onAction="#handleMyClaims" maxWidth="Infinity" styleClass="sidebar-button"/>
            <Button text="🔔 Notifications" onAction="#handleNotifications" maxWidth="Infinity" styleClass="sidebar-button"/>
        </VBox>
    </left>

    <center>
        <VBox fx:id="contentArea" spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f6f8;">

            <Label text="Dashboard Overview" styleClass="dashboard-heading"/>

            <HBox spacing="20">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="totalReportsLabel" text="0" styleClass="stat-number"/>
                    <Label text="My Reports" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="activeClaimsLabel" text="0" styleClass="stat-number"/>
                    <Label text="Active Claims" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label fx:id="notificationsLabel" text="0" styleClass="stat-number"/>
                    <Label text="Notifications" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <HBox styleClass="cta-card" alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Lost or Found something on campus?" styleClass="cta-title"/>
                    <Label text="Report it now and let the matching system find it for you." styleClass="cta-subtitle"/>
                </VBox>
                <Button text="+ Report Item" onAction="#handleReportItem" styleClass="cta-button"/>
            </HBox>

            <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                <Label text="Recent Activity" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                <Label text="No recent activity yet." style="-fx-text-fill: #999; -fx-font-size: 12px;"/>
            </VBox>

        </VBox>
    </center>
</BorderPane>